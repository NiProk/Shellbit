; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shellbit"
config/version="0.1.0"
run/main_scene="res://scenes/home/Home.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Shellbit"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.059, 0.09, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://icon.png"
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/quit_on_go_back=false

[autoload]

Settings="*res://autoload/Settings.gd"
Family="*res://autoload/Family.gd"
Profiles="*res://autoload/Profiles.gd"
Lang="*res://autoload/Lang.gd"
CoreManager="*res://autoload/CoreManager.gd"
CoreDownloader="*res://autoload/CoreDownloader.gd"
Archives="*res://autoload/Archives.gd"
Library="*res://autoload/Library.gd"
Covers="*res://autoload/Covers.gd"
InputMapper="*res://autoload/InputMapper.gd"
UiTheme="*res://autoload/UiTheme.gd"
SceneRouter="*res://autoload/SceneRouter.gd"
PadNotifier="*res://autoload/PadNotifier.gd"
UiSounds="*res://autoload/UiSounds.gd"
Haptics="*res://autoload/Haptics.gd"
Cheats="*res://autoload/Cheats.gd"
Watchdog="*res://autoload/Watchdog.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

textures/vram_compression/import_etc2_astc=true
