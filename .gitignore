# Godot: кеш импорта, создаётся сам
.godot/

# Готовая программа и архивы (Build.bat, Publish.bat)
build/
dist/

# Путь к Godot на этом компьютере (tools/godot.bat, tools/common.sh)
godot_path.txt
godot_path_linux.txt

# Ключ подписи Android (Build-Android.bat). Не публикуем, но храним копию:
# без него обновить Shellbit на телефоне можно только через удаление.
keystore/

# Gradle-сборка Android (Build-Android.bat ставит её сама, см. tools/android_tv.ps1)
android/

# Библиотека godot-cpp: native\build.bat скачивает её сам (около 200 файлов)
native/godot-cpp/

# Временные файлы
test/tmpshot/
*.tmp
