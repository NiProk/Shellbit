class_name AudioSync
extends RefCounted
## AudioSync — чтобы звук не трещал и не отставал от картинки.
##
## ЗАЧЕМ. У игры два «метронома»:
##   1) часы компьютера — по ним мы решаем, когда считать кадр приставки
##      (NES — 60,1 кадра в секунду, см. Player._process);
##   2) звуковая карта — она забирает звук со своей скоростью, например
##      ровно 48 000 сэмплов в секунду ПО СВОИМ часам.
## Эти часы никогда не идут идеально вместе. Разница крошечная (сотые доли
## процента), но за минуты она накапливается:
##   • если звук приходит чуть медленнее, чем играется, — буфер пустеет,
##     и раз в несколько секунд слышен щелчок (звуку нечего играть);
##   • если чуть быстрее — буфер переполняется, и лишний звук выбрасывается
##     (тоже щелчок).
##
## КАК ЧИНИМ — как в RetroArch («dynamic rate control»):
## Держим буфер звука заполненным на 40% (TARGET_FILL). Смотрим на него
## каждый кадр:
##   • заполнен больше нормы — звук приходит быстрее, чем играется.
##     Чуть-чуть «сжимаем» его: из 800 сэмплов делаем 798;
##   • меньше нормы — чуть «растягиваем»: из 800 делаем 802.
## Изменение не больше 0,5% — это примерно в 12 раз меньше полутона.
## Высота звука при таком плавном подруливании на слух не меняется.
##
## А если буфер почти пуст или почти полон (компьютер подтормозил, окно
## перетаскивали), одного подруливания мало — тогда Player считает лишний
## кадр приставки или пропускает один (см. extra_frames()).

## На сколько можно растянуть или сжать звук: 0,005 = ±0,5%.
const MAX_DEVIATION := 0.005
## Какую часть буфера держим заполненной.
const TARGET_FILL := 0.4
## Почти пусто — досчитать лишний кадр; почти полно — пропустить кадр.
const LOW_FILL := 0.15
const HIGH_FILL := 0.8

var capacity := 0          # сколько звуковых кадров вмещает буфер
var underruns := 0         # сколько раз буфер опустел — для отладки
var _phase := 0.0          # положение «между сэмплами» для растяжения
var _last := Vector2.ZERO  # последний сэмпл прошлого кусочка


## Насколько заполнен буфер: 0 — пуст, 1 — полон.
## frames_available — сколько в буфере свободного места.
func fill(frames_available: int) -> float:
	if capacity <= 0:
		return TARGET_FILL
	return clampf(1.0 - float(frames_available) / capacity, 0.0, 1.0)


## Во сколько раз растянуть звук. Больше 1 — сэмплов станет больше.
## Буфер заполнен как надо (TARGET_FILL) → 1.0; пуст → 1.005; полон → 0.995.
## Между ними — по прямой: чем дальше от нормы, тем сильнее подстройка.
func ratio(current_fill: float) -> float:
	var off := current_fill - TARGET_FILL  # насколько отошли от нормы
	# Делим на расстояние от нормы до края (до 0 или до 1) — так на краю
	# получается ровно ±MAX_DEVIATION, с какой стороны ни подойди.
	var room := TARGET_FILL if off < 0.0 else 1.0 - TARGET_FILL
	return 1.0 - MAX_DEVIATION * off / room


## Сколько кадров приставки досчитать сверх обычного:
##  +1 — буфер почти пуст, звук вот-вот прервётся: считаем ещё кадр;
##  −1 — буфер почти полон: этот кадр пропускаем;
##   0 — всё в порядке.
func extra_frames(current_fill: float) -> int:
	if current_fill < LOW_FILL:
		return 1
	if current_fill > HIGH_FILL:
		return -1
	return 0


## Растянуть или сжать звук в rate раз (линейная интерполяция).
## Между соседними сэмплами берём точку на прямой между ними:
##   сэмпл(1,25) = сэмпл(1) · 0,75 + сэмпл(2) · 0,25
## _phase и _last переносятся между кусочками, чтобы на стыке
## кадров не было «ступеньки» (она слышна как тихий щелчок).
func resample(input: PackedVector2Array, rate: float) -> PackedVector2Array:
	if input.is_empty():
		return input
	var step := 1.0 / rate  # насколько сдвигаемся по входу на каждый выходной сэмпл
	var output := PackedVector2Array()
	output.resize(int(ceil((input.size() - _phase + 1.0) * rate)) + 1)
	var count := 0
	var position := _phase  # 0 — это _last, 1 — input[0], 2 — input[1]…
	var size := input.size()
	while position < size:
		var index := int(position)
		var t := position - index
		var a: Vector2 = _last if index == 0 else input[index - 1]
		var b: Vector2 = input[index]
		output[count] = a.lerp(b, t)
		count += 1
		position += step
	_phase = position - size
	_last = input[size - 1]
	output.resize(count)
	return output


## Начать заново (новая игра, загрузка сохранения): забыть прошлый кусочек.
func reset() -> void:
	_phase = 0.0
	_last = Vector2.ZERO
