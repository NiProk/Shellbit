@echo off
chcp 65001 >nul
setlocal

rem ==================================================================
rem  Run.bat - запустить Shellbit из проекта, без открытия редактора.
rem  Просто двойной щелчок.
rem ==================================================================

cd /d "%~dp0"
set "ROOT=%CD%"

call "%ROOT%\tools\godot.bat" || goto :fail

rem Новые картинки и звуки (например, аватары игроков) Godot сначала должен
rem «импортировать» - подготовить для игры. Это делает редактор при открытии
rem проекта. А при запуске без редактора их бы просто не нашлось - поэтому
rem импортируем здесь. Если нового ничего нет, это пара секунд.
echo Готовлю ресурсы проекта...
"%GODOT_CONSOLE%" --headless --path "%ROOT%" --import >nul 2>&1

rem start "" - запустить и сразу закрыть это окно, не дожидаясь игры.
start "" "%GODOT%" --path "%ROOT%"
exit /b 0

:fail
pause
exit /b 1
