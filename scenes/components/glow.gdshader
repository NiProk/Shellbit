shader_type canvas_item;
// Свечение цвета приставки (см. Backdrop.gd): мягкое пятно света,
// которое «разливается» из левого нижнего угла — оттуда, где плитки.
//
// blend_add — «сложение»: цвет ПРИБАВЛЯЕТСЯ к тому, что уже нарисовано
// под нами, как свет фонарика. Тёмный фон от этого краснеет (зеленеет…),
// а не закрашивается сплошным цветом.
render_mode blend_add;

uniform vec4 glow_color : source_color = vec4(0.0);  // цвет; alpha — сила (0 — нет свечения)
uniform vec2 center = vec2(0.12, 1.05);   // откуда светит (0,0 — левый верх экрана, 1,1 — правый низ)
uniform float reach = 1.0;                // как далеко дотягивается свет

void fragment() {
	// Расстояние от источника. По горизонтали экран шире — растягиваем пятно
	// (умножение на 0.6), чтобы свет растекался вдоль ряда плиток.
	vec2 delta = (SCREEN_UV - center) * vec2(0.6, 1.0);
	float d = length(delta) / reach;
	// Свет спадает плавно: у источника 1, к краю — 0.
	// Квадрат делает спад мягче, без заметной «границы» пятна.
	float light = pow(clamp(1.0 - d, 0.0, 1.0), 2.0);
	COLOR = vec4(glow_color.rgb * light * glow_color.a, 1.0);
}
