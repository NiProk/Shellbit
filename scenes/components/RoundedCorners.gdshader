shader_type canvas_item;
// Шейдер — маленькая программа, которая решает, какого цвета каждый пиксель.
// Этот шейдер скругляет углы картинки: пиксели за пределами
// скруглённого прямоугольника делает прозрачными.
//
// А ещё умеет чуть повернуть и приблизить картинку ВНУТРИ рамки — так
// приставка на выделенной плитке «берётся в руки» (см. ConsoleTile.gd),
// а скруглённые углы самой плитки при этом остаются на месте.

uniform vec2 size = vec2(168.0, 120.0); // размер узла в пикселях (задаёт скрипт)
uniform float radius = 14.0;            // радиус скругления, как у фона плитки
uniform float tilt = 0.0;               // поворот картинки, в радианах (0,06 ≈ 3,5°)
uniform float zoom = 1.0;               // приближение: 1 — как есть, 1,08 — на 8% крупнее
uniform vec2 pivot = vec2(0.72, 0.55);  // вокруг какой точки (в долях картинки): там стоит приставка
uniform float raise = 0.0;              // насколько поднять картинку (в долях её высоты)

// varying — значение, которое передаётся из vertex() в fragment().
varying vec2 local_pos;
varying vec4 tint;

void vertex() {
	// VERTEX — координата угла картинки внутри узла (от 0,0 до size).
	local_pos = VERTEX;
	tint = COLOR;  // modulate узла (притушенная картинка у невыделенной плитки)
}

void fragment() {
	// Поворот и приближение: для каждой точки рамки ищем, откуда в картинке
	// взять цвет. Считаем в пикселях картинки, а не в долях (UV), иначе
	// у не квадратной картинки поворот бы её перекашивал.
	vec2 texture_size = 1.0 / TEXTURE_PIXEL_SIZE;
	vec2 p = (UV - pivot) * texture_size;
	float c = cos(tilt);
	float s = sin(tilt);
	p = mat2(vec2(c, -s), vec2(s, c)) * p / zoom;
	// raise > 0 — берём цвет из точки пониже, и картинка будто поднимается вверх.
	vec2 uv = pivot + p / texture_size + vec2(0.0, raise);
	// clamp — за краем картинки берём её крайние точки (там однотонный фон).
	COLOR = texture(TEXTURE, clamp(uv, vec2(0.0), vec2(1.0))) * tint;

	// Расстояние от пикселя до края скруглённого прямоугольника:
	// меньше нуля — пиксель внутри, больше нуля — снаружи.
	vec2 half_size = size * 0.5;
	vec2 q = abs(local_pos - half_size) - (half_size - vec2(radius));
	float dist = length(max(q, 0.0)) - radius;
	// Внутри — непрозрачно, снаружи — прозрачно, на границе — плавно (без «лесенки»).
	COLOR.a *= clamp(0.5 - dist, 0.0, 1.0);
}
