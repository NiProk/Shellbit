shader_type canvas_item;
// Узор фона «Пиксельные звёзды» (см. Backdrop.gd): редкие квадратики
// разной яркости — звёздное небо из 8-битной игры. Звёзды мерцают
// и очень медленно плывут вверх.

// «Случайное» число от 0 до 1 для каждой клетки — всегда одно и то же
// для одной клетки, поэтому звёзды не прыгают с места на место.
float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment() {
	// TIME — секунды с запуска программы: от него звёзды и движутся.
	vec2 pos = SCREEN_UV * vec2(1920.0, 1080.0) + vec2(0.0, TIME * 8.0);
	vec2 cell = floor(pos / 6.0);         // экран — сетка клеток 6×6
	float h = hash(cell);
	float star = step(0.992, h);          // звезда только в 0,8% клеток
	float twinkle = 0.5 + 0.5 * sin(TIME * 2.0 + h * 50.0);  // у каждой — своё мерцание
	COLOR = vec4(1.0, 1.0, 1.0, star * (0.08 + 0.18 * twinkle * fract(h * 97.0)));
}
