shader_type canvas_item;
// Узор фона «Пиксельная сетка» (см. Backdrop.gd): маленькие квадратные
// точки через ровные промежутки — как экран старого монитора вблизи.

void fragment() {
	// Координаты в «пикселях экрана 1920×1080» — так узор одного размера
	// и в окне, и во весь экран, и на 4K-мониторе.
	vec2 pos = SCREEN_UV * vec2(1920.0, 1080.0);
	vec2 cell = mod(pos, 28.0);  // положение внутри клетки 28×28
	// step(a, b) — 1, если b >= a. Точка — в углу клетки, 3×3 пикселя.
	float dot_ = step(cell.x, 3.0) * step(cell.y, 3.0);
	COLOR = vec4(1.0, 1.0, 1.0, dot_ * 0.07);
}
