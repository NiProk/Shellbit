; Описание C++-модуля для Godot: какую функцию вызвать при загрузке
; и где лежит .dll для каждой системы.

[configuration]

entry_symbol = "shellbit_core_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://addons/shellbit_core/bin/shellbit_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/shellbit_core/bin/shellbit_core.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/shellbit_core/bin/shellbit_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/shellbit_core/bin/shellbit_core.linux.template_release.x86_64.so"
